<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet shown when user taps the three-dot on a song -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_card"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <!-- Song title header -->
    <TextView
        android:id="@+id/tv_sheet_song_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF"
        android:layout_marginBottom="8dp" />

    <!-- Add to playlist -->
    <LinearLayout
        android:id="@+id/option_add_to_playlist"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/add_icon"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add to playlist"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- Remove from playlist -->
    <LinearLayout
        android:id="@+id/option_remove_from_playlist"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_delete"
            app:tint="#FF6B6B" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remove from playlist"
            android:textColor="#FF6B6B"
            android:textSize="15sp"
            android:layout_marginStart="16dp"/>

    </LinearLayout>

</LinearLayout>