<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <!-- COLLAPSING HEADER -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@drawable/bg_main_gradient"
            app:expandedTitleMarginStart="20dp"
            app:expandedTitleMarginBottom="60dp"
            app:expandedTitleTextAppearance="@style/TextAppearance.AppCompat.Large"
            app:collapsedTitleTextAppearance="@style/TextAppearance.AppCompat.Medium">

            <!-- COVER — collapses on scroll -->
            <ImageView
                android:id="@+id/iv_detail_cover"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="48dp"
                android:scaleType="centerCrop"
                android:src="@drawable/add_playlist_cover"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.7"/>

            <!-- BACK BUTTON — pinned top-left -->
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|start"
                android:layout_margin="16dp"
                android:src="@drawable/back_icon"
                app:layout_collapseMode="pin"
                app:tint="#FFFFFF" />

            <!-- EDIT BUTTON — pinned top-right -->
            <ImageView
                android:id="@+id/btn_edit_playlist"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_margin="16dp"
                android:src="@drawable/ic_edit"
                app:layout_collapseMode="pin"
                app:tint="#FFFFFF" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="160dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TITLE + SONG COUNT + PLAY BUTTON ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp">

                <!-- Title + count stacked -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <!-- Song count — e.g. "12 songs" -->
                    <TextView
                        android:id="@+id/tv_song_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 songs"
                        android:textColor="#B3FFFFFF"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_play_playlist"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="start play"
                    android:src="@drawable/play_icon"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="#FFFFFF" />

            </LinearLayout>

            <!-- SONG LIST -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_playlist_songs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingTop="8dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom">

        <include
            android:id="@+id/cv_now_playing_bar"
            layout="@layout/layout_now_playing_bar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:visibility="gone"/>

        <include
            android:id="@+id/bottom_nav_container"
            layout="@layout/layout_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>