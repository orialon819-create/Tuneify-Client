<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet for editing playlist name and cover -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_card"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Playlist"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <!-- Cover picker -->
    <ImageView
        android:id="@+id/iv_edit_cover_preview"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:scaleType="centerCrop"
        android:src="@drawable/add_playlist_cover"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_change_cover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Change cover"
        android:textColor="#AAAAFF"
        android:textSize="13sp"
        android:layout_marginBottom="20dp"/>

    <!-- Name field -->
    <EditText
        android:id="@+id/et_edit_playlist_name"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Playlist name"
        android:textColorHint="#88FFFFFF"
        android:textColor="#FFFFFF"
        android:background="@drawable/glass_card"
        android:paddingHorizontal="14dp"
        android:inputType="text"
        android:layout_marginBottom="16dp"/>

    <!-- Save button -->
    <Button
        android:id="@+id/btn_save_playlist_edit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Save"
        android:textColor="#FFFFFF"
        android:background="@drawable/glass_card"/>

</LinearLayout>