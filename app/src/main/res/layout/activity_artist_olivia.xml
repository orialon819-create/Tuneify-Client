<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0D0820">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="520dp">

                <ImageView
                    android:id="@+id/iv_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/add_playlist_cover" />

                <!-- dark overlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="#88000000" />

                <!-- bottom fade -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_gravity="bottom"
                    android:background="#CC0D0820" />

                <!-- spotlight label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp"
                    android:layout_gravity="top|start"
                    android:layout_marginTop="52dp"
                    android:text="ARTIST SPOTLIGHT"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:letterSpacing="0.14"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:background="#663D1A8A" />

                <!-- back button -->
                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="16dp"
                    android:src="@drawable/back_icon"
                    android:background="#553D1A8A"
                    android:padding="8dp"
                    app:tint="#FFFFFF" />

                <!-- title section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingHorizontal="22dp"
                    android:paddingBottom="32dp">

                    <TextView
                        android:id="@+id/tv_artist_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Olivia Rodrigo"
                        android:textColor="#FFFFFF"
                        android:textSize="52sp"
                        android:fontFamily="sans-serif-thin"
                        android:lineSpacingMultiplier="0.9"
                        android:shadowColor="#AA7C3AED"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="20" />

                    <TextView
                        android:id="@+id/tv_sub_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modern Emotional Pop Voice"
                        android:textColor="#C4B5FD"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-light"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

            </FrameLayout>

            <!-- INTRO CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#3D1A8A"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-24dp"
                android:padding="22dp">

                <TextView
                    android:id="@+id/tv_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#E8E0FF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-light"
                    android:lineSpacingMultiplier="1.7" />

            </LinearLayout>

            <!-- WHY SHE MATTERS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Why She Matters"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginStart="20dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/ll_why_matter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp" />

            <!-- DISCOGRAPHY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discography"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginStart="20dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_albums"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:clipToPadding="false" />

            <!-- NOTABLE TRACKS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notable Tracks"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginStart="20dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/ll_tracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp" />

            <!-- FUN FACTS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fun Facts"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginStart="20dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_facts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:clipToPadding="false"
                android:layout_marginBottom="8dp" />

            <!-- FOOTER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A0D35"
                android:padding="28dp"
                android:layout_marginTop="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best listened to when…"
                    android:textColor="#7C3AED"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_footer_mood"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAACC"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-light"
                    android:lineSpacingMultiplier="1.6" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- NOW PLAYING BAR -->
    <include
        android:id="@+id/cv_now_playing_bar"
        layout="@layout/layout_now_playing_bar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:visibility="gone" />

</FrameLayout>